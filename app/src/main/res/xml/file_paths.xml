<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the generated share cards are exposed. They live in a subdirectory of the
  cache so nothing else the app caches — feed bodies, Coil's images, the import
  scratch files — is reachable through the provider.
-->
<paths>
    <cache-path
        name="share_cards"
        path="share-cards/" />
</paths>
